# 复制成 backend/.env 再填。
# 更推荐直接在网页「设置」里填 —— 那里填的值优先，存在本机 SQLite 并加密；这个文件只是兜底。
# 下面的默认值与 app/core/config.py 一致，不填就用默认。

# ── 运行模式 ──
# local（默认）：全部在本机调度，所有 key 自己填
# cloud_client：需要自行部署 cloud/ 网关，并在设置里填网关地址
# OCTOPUS_DEPLOYMENT_MODE=local

# ── 大模型：LLM_PROVIDER 选哪家就填哪家 ──
LLM_PROVIDER=kimi                     # kimi | openai | deepseek

KIMI_API_KEY=
KIMI_BASE_URL=https://api.kimi.com/coding/v1
KIMI_MODEL=kimi-for-coding

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4

# ── 视频：火山方舟 Seedance ──
SEEDANCE_API_KEY=
SEEDANCE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
SEEDANCE_MODEL=doubao-seedance-2-0-260128
SEEDANCE_FAST_MODEL=doubao-seedance-1-0-pro-fast-251015

# ── 出图 ──
# 火山 Seedream（local 模式下不填 SEEDREAM_API_KEY 就沿用 SEEDANCE_API_KEY，同一个方舟账号）
SEEDREAM_API_KEY=
SEEDREAM_BASE_URL=
SEEDREAM_IMAGE_EDIT_MODEL=
ARK_IMAGE_EDIT_MODEL=doubao-seedream-4-0-250828

ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_IMAGE_MODEL=glm-image

GOOGLE_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview

# ── 其他 ──
DATABASE_URL=sqlite+aiosqlite:///./octopus.db
# OCTOPUS_OUTPUT_DIR=./output          # 生成的图片 / 视频 / 音频放哪
# OCTOPUS_MASTER_KEY_FILE=             # 加密主密钥位置，默认 ~/.octopus/master.key
